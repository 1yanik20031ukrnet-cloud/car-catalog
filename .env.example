# Образец файла окружения. Скопируйте его в .env рядом с manage.py
# и подставьте свои значения. Сам .env в репозиторий не попадает
# (он в .gitignore) — настоящие ключи и токены живут только там.
#
# Локально этот файл вообще не нужен: без него проект работает
# в режиме разработки ровно как раньше.

# Режим отладки. На боевом сервере обязательно 0 — иначе посетитель
# при любой ошибке увидит кусок кода и настроек проекта.
DJANGO_DEBUG=1

# Ключ, которым Django подписывает сессии и формы. Нужен, только когда
# DJANGO_DEBUG=0 — без него проект намеренно откажется запускаться.
# Сгенерировать новый:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Значение ниже — не ключ, а заглушка: не используйте его.
DJANGO_SECRET_KEY=

# Домены, с которых сайт отвечает, через запятую.
# Пример: DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

# Нужно, если сайт работает по https (обычно так и будет).
# Со схемой, через запятую: https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Включает настройки https: перенаправление http→https, защищённые куки
# и HSTS. Включать ТОЛЬКО когда сертификат уже работает и сайт реально
# открывается по https, иначе можно потерять доступ к своему же сайту.
DJANGO_SECURE_SSL=0

# Срок HSTS в секундах. Начинать с малого (3600 — час), поднимать до
# года, только убедившись, что всё работает. 0 — выключено.
DJANGO_HSTS_SECONDS=0
